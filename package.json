{
  "name": "starsync",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "wrangler types && astro build && astro preview",
    "deploy": "wrangler types && astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute starsync-db --local --file=./db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute starsync-db --remote --file=./db/schema.sql"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "astronomia": "^4.2.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.145.0"
  }
}
